# Copy to apps/web/.env.local (gitignored). Never commit real keys.
# Server-only (no NEXT_PUBLIC prefix = never ships to the browser):
# Direct TypeSafe key — what the provider reads by default:
TYPESAFE_AI_API_KEY=
# Alternate name, also accepted by the route:
TYPESAFE_API_KEY=
# Vercel AI Gateway key (alternate path, model typesafe-ai/jev):
AI_GATEWAY_API_KEY=
# Public: where the browser reaches the Go API:
NEXT_PUBLIC_API_URL=http://localhost:8081
