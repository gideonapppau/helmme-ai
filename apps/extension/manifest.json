{
  "manifest_version": 3,
  "name": "helmme",
  "version": "0.1.0",
  "description": "Save anything. Organize nothing. Find everything.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to helmme"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8081/*"]
}
