{
  "manifest_version": 3,
  "name": "helmme",
  "version": "0.1.0",
  "description": "Save anything. Organize nothing. Find everything.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to helmme"
  },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:8081/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save this page to helmme"
    }
  }
}
